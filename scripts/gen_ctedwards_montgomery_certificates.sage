# Regenerates the generated section of
# CompElliptic/CurveForms/CtEdwardsMontgomeryCertificates.lean: everything below the marker
# line. The hand-written module doc above the marker is left untouched. See that module's
# doc-comment for what each certificate states; this script is the single source for the theorem
# statements and proofs.
#
# Method, per certificate:
#   1. Form the difference of the two sides as a rational function over Q(a, d, u1, v1, u2, v2),
#      with the map x = (1 + v)/(1 - v), y = u·(a - d·v²)/(1 - v)² and the Edwards sum written out,
#      and take the numerator N of its reduced form.
#   2. Obtain the cofactors of N over the curve equations with Singular's `lift`.
#   3. Assert the emitted identity by exact polynomial expansion. No Gröbner output is trusted:
#      a wrong cofactor fails this assert, and Lean's `ring` re-checks the same identity on build.
#   4. Emit with a fixed layout, exponents typed `^(n:ℕ)`, wrapped to 96 columns.
import re
import textwrap


def lw(poly, indent, reserve=0):
    # Exponents are typed `^(n:ℕ)`: with bare `^n` Lean's elaboration of these statements does
    # not finish within any bounded heartbeat limit; typed, the module checks in seconds.
    s_ = re.sub(r"\^(\d+)", r"^(\1:ℕ)", str(poly))
    body = textwrap.wrap(s_, width=96 - indent - reserve, break_long_words=False,
                         break_on_hyphens=False)
    return ("\n" + " " * indent).join(body)


R = PolynomialRing(QQ, ["a", "d", "u1", "v1", "u2", "v2"], order="degrevlex")
a, d, u1, v1, u2, v2 = R.gens()
K = R.fraction_field()

curve = lambda u, v: a*u^2 + v^2 - 1 - d*u^2*v^2
A = K(2*(a + d)) / (a - d)
B = K(4) / (a - d)
mx = lambda v: (1 + K(v)) / (1 - v)
my = lambda u, v: K(u) * (a - d*v^2) / (1 - v)^2

# The chord: P₁ + P₂.
t = d*u1*u2*v1*v2
x1, y1, x2, y2 = mx(v1), my(u1, v1), mx(v2), my(u2, v2)
l = (y1 - y2) / (x1 - x2)
x3 = mx((v1*v2 - a*u1*u2) / K(1 - t))
y3 = my((u1*v2 + v1*u2) / K(1 + t), (v1*v2 - a*u1*u2) / K(1 - t))
# The tangent: P₁ + P₁.
s = d*u1^2*v1^2
lt = (3*x1^2 + 2*A*x1 + 1) / (2*B*y1)
x3t = mx((v1^2 - a*u1^2) / K(1 - s))
y3t = my(2*u1*v1 / K(1 + s), (v1^2 - a*u1^2) / K(1 - s))

items = [
    ("chord_x", "x", "chord", B*l^2 - A - x1 - x2 - x3, 2),
    ("chord_y", "y", "chord", l*(x1 - x3) - y1 - y3, 2),
    ("tangent_x", "x", "tangent", B*lt^2 - A - 2*x1 - x3t, 1),
    ("tangent_y", "y", "tangent", lt*(x1 - x3t) - y1 - y3t, 1),
]

docs = {
    "chord_x": "Chord, `x`-coordinate: the numerator of `B·ℓ² − A − x₁ − x₂ − x₃` vanishes, for\n"
               "the images of `P₁`, `P₂`, their chord slope `ℓ`, and the image's `x₃` of\n"
               "`P₁ + P₂`.",
    "chord_y": "Chord, `y`-coordinate: the numerator of `ℓ·(x₁ − x₃) − y₁ − y₃` vanishes, for\n"
               "the images of `P₁`, `P₂`, their chord slope `ℓ`, and the image `(x₃, y₃)` of\n"
               "`P₁ + P₂`.",
    "tangent_x": "Tangent, `x`-coordinate: the numerator of `B·ℓ² − A − 2·x₁ − x₃` vanishes, for\n"
                 "the image of `P₁`, its tangent slope `ℓ`, and the image's `x₃` of\n"
                 "`P₁ + P₁`.",
    "tangent_y": "Tangent, `y`-coordinate: the numerator of `ℓ·(x₁ − x₃) − y₁ − y₃` vanishes, for\n"
                 "the image of `P₁`, its tangent slope `ℓ`, and the image `(x₃, y₃)` of\n"
                 "`P₁ + P₁`.",
}

curve_hyp = "    (h{i} : a*u{i}^2 + v{i}^2 = 1 + d*u{i}^2*v{i}^2)"
names = ["h1", "h2"]

tmpl = """\
/-- {doc} -/
theorem toMontgomery_{name}_certificate {{F : Type*}} [CommRing F] ({vars} : F)
{hyps} :
    ({goal}) = 0 :=
  by
    linear_combination
      {combo}"""

blocks = []
for name, _, _, diff, n in items:
    N = R(diff.numerator())
    curves = [curve(u1, v1), curve(u2, v2)][:n]
    cof = N.lift(R.ideal(curves))
    assert sum(c*h for c, h in zip(cof, curves)) == N, name
    print(name, "sizes: N", len(N.monomials()), "cofs", [len(c.monomials()) for c in cof])
    combo = "\n      + ".join(lw("({}) * {}".format(c, nm), 8)
                            for c, nm in zip(cof, names) if c != 0)
    blocks.append(tmpl.format(
        doc=docs[name], name=name,
        vars="a d u1 v1 u2 v2" if n == 2 else "a d u1 v1",
        hyps="\n".join(curve_hyp.format(i=i) for i in range(1, n + 1)),
        goal=lw(N, 6, reserve=len(") = 0 :=")), combo=combo))
text = "\n\n".join(blocks) + "\n"
# The Sage ring names u1 … v2 stand for the Lean identifiers u₁ … v₂; likewise h1 for h₁
# (whole words only).
sub = dict(zip("12", "₁₂"))
text = re.sub(r"\b([uvh])([12])\b", lambda m: m.group(1) + sub[m.group(2)], text)

long = [line for line in text.split("\n") if len(line) > 100]
assert not long, long[:3]
print("layout: no line over 100 characters")

module_path = "CompElliptic/CurveForms/CtEdwardsMontgomeryCertificates.lean"
marker = ("-- The declarations below are generated by "
          "`scripts/gen_ctedwards_montgomery_certificates.sage`;")
src = open(module_path).read()
assert marker in src, "marker line not found in " + module_path
head = src[:src.index(marker)]
out = (head + marker + "\n"
       + "-- edit and re-run that script rather than editing them here.\n\n"
       + text + "\nend CompElliptic.CurveForms.CtEdwards\n")
with open(module_path, "w") as f:
    f.write(out)
print("regenerated " + module_path)
