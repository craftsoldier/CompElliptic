theorem add_assoc_v_certificate {F : Type*} [CommRing F]
    (a d u₁ v₁ u₂ v₂ u₃ v₃ u₄ v₄ u₅ v₅ : F)
    (h₁ : a*u₁^2 + v₁^2 = 1 + d*u₁^2*v₁^2)
    (h₂ : a*u₂^2 + v₂^2 = 1 + d*u₂^2*v₂^2)
    (h₃ : a*u₃^2 + v₃^2 = 1 + d*u₃^2*v₃^2)
    (e₄u : u₄ * (d*u₁*v₁*u₂*v₂ + 1) = v₁*u₂ + u₁*v₂)
    (e₄v : v₄ * (-d*u₁*v₁*u₂*v₂ + 1) = -a*u₁*u₂ + v₁*v₂)
    (e₅u : u₅ * (d*u₂*v₂*u₃*v₃ + 1) = v₂*u₃ + u₂*v₃)
    (e₅v : v₅ * (-d*u₂*v₂*u₃*v₃ + 1) = -a*u₂*u₃ + v₂*v₃) :
    (-a*d^5*u₁^3*v₁^2*u₂^4*v₂^4*u₃^3*v₃^3*u₄*v₄*u₅ +
      a*d^5*u₁^3*v₁^3*u₂^4*v₂^4*u₃^3*v₃^2*u₄*u₅*v₅ + d^5*u₁^2*v₁^3*u₂^4*v₂^4*u₃^3*v₃^3*u₄*v₄*v₅
      - d^5*u₁^3*v₁^3*u₂^4*v₂^4*u₃^2*v₃^3*v₄*u₅*v₅ - a*d^4*u₁^2*v₁^2*u₂^4*v₂^4*u₃^3*v₃^2*u₄ +
      a*d^4*u₁^3*v₁^2*u₂^4*v₂^4*u₃^2*v₃^2*u₅ + d^4*u₁^2*v₁^2*u₂^4*v₂^4*u₃^2*v₃^3*v₄ -
      d^4*u₁^2*v₁^3*u₂^4*v₂^4*u₃^2*v₃^2*v₅ + a*d^3*u₁^3*v₁^2*u₂^2*v₂^2*u₃*v₃*u₄*v₄*u₅ +
      a*d^3*u₁*u₂^2*v₂^2*u₃^3*v₃^3*u₄*v₄*u₅ - a*d^3*u₁^3*v₁^3*u₂^2*v₂^2*u₃*u₄*u₅*v₅ -
      a*d^3*u₁*v₁*u₂^2*v₂^2*u₃^3*v₃^2*u₄*u₅*v₅ - d^3*u₁^2*v₁^3*u₂^2*v₂^2*u₃*v₃*u₄*v₄*v₅ -
      d^3*v₁*u₂^2*v₂^2*u₃^3*v₃^3*u₄*v₄*v₅ + d^3*u₁^3*v₁^3*u₂^2*v₂^2*v₃*v₄*u₅*v₅ +
      d^3*u₁*v₁*u₂^2*v₂^2*u₃^2*v₃^3*v₄*u₅*v₅ + a*d^2*u₁^2*v₁^2*u₂^2*v₂^2*u₃*u₄ +
      a*d^2*u₂^2*v₂^2*u₃^3*v₃^2*u₄ - a*d^2*u₁^3*v₁^2*u₂^2*v₂^2*u₅ -
      a*d^2*u₁*u₂^2*v₂^2*u₃^2*v₃^2*u₅ - d^2*u₁^2*v₁^2*u₂^2*v₂^2*v₃*v₄ -
      d^2*u₂^2*v₂^2*u₃^2*v₃^3*v₄ + d^2*u₁^2*v₁^3*u₂^2*v₂^2*v₅ + d^2*v₁*u₂^2*v₂^2*u₃^2*v₃^2*v₅ -
      a*d*u₁*u₃*v₃*u₄*v₄*u₅ + a*d*u₁*v₁*u₃*u₄*u₅*v₅ + d*v₁*u₃*v₃*u₄*v₄*v₅ - d*u₁*v₁*v₃*v₄*u₅*v₅
      - a*u₃*u₄ + a*u₁*u₅ + v₃*v₄ - v₁*v₅) = 0 :=
  by
    linear_combination
      (-a^3*v₁*u₂^3*u₃^3 - a^3*u₁*u₂^2*v₂*u₃^3 - a^3*u₁*u₂^3*u₃^2*v₃ - a^2*v₁*u₂*v₂^2*u₃^3 -
        a^2*u₁*v₂^3*u₃^3 + a^2*v₁*u₂^2*v₂*u₃^2*v₃ - a*d*v₁*u₂^2*v₂*u₃^2*v₃ -
        a^2*u₁*u₂*v₂^2*u₃^2*v₃ + a*d*u₁*u₂*v₂^2*u₃^2*v₃ - a^2*v₁*u₂^3*u₃*v₃^2 -
        a^2*u₁*u₂^2*v₂*u₃*v₃^2 + a*d*u₁*u₂^2*v₂*u₃*v₃^2 - a^2*u₁*u₂^3*v₃^3 + a*v₁*v₂^3*u₃^2*v₃ -
        a*v₁*u₂*v₂^2*u₃*v₃^2 + d*v₁*u₂*v₂^2*u₃*v₃^2 - a*u₁*v₂^3*u₃*v₃^2 + a*v₁*u₂^2*v₂*v₃^3 -
        a*u₁*u₂*v₂^2*v₃^3 + a^2*v₁*u₂^3*u₃ + a^2*u₁*u₂^2*v₂*u₃ + a^2*v₁*u₂*u₃^3 + a^2*u₁*v₂*u₃^3
        + a^2*u₁*u₂^3*v₃ + a^2*u₁*u₂*u₃^2*v₃ + v₁*v₂^3*v₃^3 + a*v₁*u₂*v₂^2*u₃ + a*u₁*v₂^3*u₃ -
        a*v₁*u₂^2*v₂*v₃ + a*u₁*u₂*v₂^2*v₃ - a*v₁*v₂*u₃^2*v₃ + a*v₁*u₂*u₃*v₃^2 + a*u₁*v₂*u₃*v₃^2
        + a*u₁*u₂*v₃^3 - v₁*v₂^3*v₃ - v₁*v₂*v₃^3 - a*v₁*u₂*u₃ - a*u₁*v₂*u₃ - a*u₁*u₂*v₃ +
        v₁*v₂*v₃) * h₁
      + (a*d^2*u₁^2*v₁^3*u₂^2*v₂*u₃^2*v₃ - a*d^2*u₁^3*v₁^2*u₂*v₂^2*u₃^2*v₃ -
        a*d^2*u₁^3*v₁^2*u₂^2*v₂*u₃*v₃^2 - d^2*u₁^2*v₁^3*u₂*v₂^2*u₃*v₃^2 -
        a^2*d*u₁^2*v₁^3*u₂*u₃^3 - a^2*d*u₁^3*v₁^2*v₂*u₃^3 + a^2*d*u₁*v₁^2*u₂^2*v₂*u₃^3 +
        a^2*d*u₁^2*v₁*u₂*v₂^2*u₃^3 - a^2*d*u₁^3*v₁^2*u₂*u₃^2*v₃ - a^2*d*u₁^2*v₁*u₂^2*v₂*u₃^2*v₃
        + a*d*u₁^2*v₁^3*v₂*u₃^2*v₃ + a*d*u₁*v₁^2*u₂*v₂^2*u₃^2*v₃ - a*d*u₁^2*v₁^3*u₂*u₃*v₃^2 -
        a*d*u₁^3*v₁^2*v₂*u₃*v₃^2 + a*d*u₁*v₁^2*u₂^2*v₂*u₃*v₃^2 + a*d*u₁^2*v₁*u₂*v₂^2*u₃*v₃^2 -
        a*d*u₁^3*v₁^2*u₂*v₃^3 - a*d*u₁^2*v₁*u₂^2*v₂*v₃^3 + a^3*u₁^2*v₁*u₂*u₃^3 +
        a^3*u₁^3*v₂*u₃^3 + a^3*u₁^3*u₂*u₃^2*v₃ + d*u₁^2*v₁^3*v₂*v₃^3 + d*u₁*v₁^2*u₂*v₂^2*v₃^3 +
        a*d*u₁^2*v₁^3*u₂*u₃ + a*d*u₁^3*v₁^2*v₂*u₃ - a*d*u₁*v₁^2*u₂^2*v₂*u₃ -
        a*d*u₁^2*v₁*u₂*v₂^2*u₃ + a^2*v₁^3*u₂*u₃^3 + a^2*u₁*v₁^2*v₂*u₃^3 + a*d*u₁^3*v₁^2*u₂*v₃ +
        a*d*u₁^2*v₁*u₂^2*v₂*v₃ + a^2*u₁*v₁^2*u₂*u₃^2*v₃ - a^2*u₁^2*v₁*v₂*u₃^2*v₃ +
        a^2*u₁^2*v₁*u₂*u₃*v₃^2 + a^2*u₁^3*v₂*u₃*v₃^2 + a^2*u₁^3*u₂*v₃^3 - d*u₁^2*v₁^3*v₂*v₃ -
        d*u₁*v₁^2*u₂*v₂^2*v₃ - a*v₁^3*v₂*u₃^2*v₃ + a*v₁^3*u₂*u₃*v₃^2 + a*u₁*v₁^2*v₂*u₃*v₃^2 +
        a*u₁*v₁^2*u₂*v₃^3 - a*u₁^2*v₁*v₂*v₃^3 - a^2*u₁^2*v₁*u₂*u₃ - a^2*u₁^3*v₂*u₃ -
        a^2*v₁*u₂*u₃^3 - a^2*u₁*v₂*u₃^3 - a^2*u₁^3*u₂*v₃ - a^2*u₁*u₂*u₃^2*v₃ - v₁^3*v₂*v₃^3 -
        a*v₁^3*u₂*u₃ - a*u₁*v₁^2*v₂*u₃ - a*u₁*v₁^2*u₂*v₃ + a*u₁^2*v₁*v₂*v₃ + a*v₁*v₂*u₃^2*v₃ -
        a*v₁*u₂*u₃*v₃^2 - a*u₁*v₂*u₃*v₃^2 - a*u₁*u₂*v₃^3 + v₁^3*v₂*v₃ + v₁*v₂*v₃^3 + a*v₁*u₂*u₃
        + a*u₁*v₂*u₃ + a*u₁*u₂*v₃ - v₁*v₂*v₃) * h₂
      + (a*d^2*u₁*v₁^2*u₂^4*v₂^3*u₃ + a*d^2*u₁^2*v₁*u₂^3*v₂^4*u₃ - a*d^2*u₁^2*v₁*u₂^4*v₂^3*v₃ +
        d^2*u₁*v₁^2*u₂^3*v₂^4*v₃ - a^2*d*u₁*v₁^2*u₂^4*v₂*u₃ + a^2*d*u₁^3*u₂^2*v₂^3*u₃ +
        a^2*d*u₁^2*v₁*u₂^4*v₂*v₃ + a^2*d*u₁^3*u₂^3*v₂^2*v₃ + a*d*v₁^3*u₂^3*v₂^2*u₃ -
        a*d*u₁^2*v₁*u₂*v₂^4*u₃ - d*v₁^3*u₂^2*v₂^3*v₃ - d*u₁*v₁^2*u₂*v₂^4*v₃ -
        a*d*v₁*u₂^3*v₂^2*u₃ - a*d*u₁*u₂^2*v₂^3*u₃ - a*d*u₁*u₂^3*v₂^2*v₃ + d*v₁*u₂^2*v₂^3*v₃) *
        h₃
      + (-a*d^4*u₁^2*v₁*u₂^3*v₂^3*u₃^3*v₃^3*v₄*u₅ + a*d^4*u₁^2*v₁^2*u₂^3*v₂^3*u₃^3*v₃^2*u₅*v₅ +
        d^4*u₁*v₁^2*u₂^3*v₂^3*u₃^3*v₃^3*v₄*v₅ - a*d^3*u₁*v₁*u₂^3*v₂^3*u₃^3*v₃^2 +
        a*d^3*u₁*u₂^2*v₂^2*u₃^3*v₃^3*v₄*u₅ - a*d^3*u₁*v₁*u₂^2*v₂^2*u₃^3*v₃^2*u₅*v₅ -
        d^3*v₁*u₂^2*v₂^2*u₃^3*v₃^3*v₄*v₅ + a*d^2*u₂^2*v₂^2*u₃^3*v₃^2 +
        a*d^2*u₁^2*v₁*u₂*v₂*u₃*v₃*v₄*u₅ - a*d^2*u₁^2*v₁^2*u₂*v₂*u₃*u₅*v₅ -
        d^2*u₁*v₁^2*u₂*v₂*u₃*v₃*v₄*v₅ + a*d*u₁*v₁*u₂*v₂*u₃ - a*d*u₁*u₃*v₃*v₄*u₅ +
        a*d*u₁*v₁*u₃*u₅*v₅ + d*v₁*u₃*v₃*v₄*v₅ - a*u₃) * e₄u
      + (d^4*u₁^2*v₁^2*u₂^3*v₂^3*u₃^2*v₃^3*u₅*v₅ + a*d^3*u₁*v₁*u₂^3*v₂^2*u₃^3*v₃^3*u₅ +
        a*d^3*u₁^2*u₂^2*v₂^3*u₃^3*v₃^3*u₅ - d^3*v₁^2*u₂^3*v₂^2*u₃^3*v₃^3*v₅ -
        d^3*u₁*v₁*u₂^2*v₂^3*u₃^3*v₃^3*v₅ - d^3*u₁*v₁*u₂^3*v₂^3*u₃^2*v₃^3 +
        d^3*u₁*v₁*u₂^2*v₂^2*u₃^2*v₃^3*u₅*v₅ - d^2*u₂^2*v₂^2*u₃^2*v₃^3 -
        d^2*u₁^2*v₁^2*u₂*v₂*v₃*u₅*v₅ - a*d*u₁*v₁*u₂*u₃*v₃*u₅ - a*d*u₁^2*v₂*u₃*v₃*u₅ +
        d*v₁^2*u₂*u₃*v₃*v₅ + d*u₁*v₁*v₂*u₃*v₃*v₅ + d*u₁*v₁*u₂*v₂*v₃ - d*u₁*v₁*v₃*u₅*v₅ + v₃) *
        e₄v
      + (a*d^3*u₁^2*v₁^3*u₂^3*v₂^2*u₃^2*v₃*v₅ + a*d^3*u₁^3*v₁^2*u₂^2*v₂^3*u₃^2*v₃*v₅ -
        a*d^3*u₁^3*v₁^2*u₂^3*v₂^2*u₃*v₃^2*v₅ + a*d^3*u₁^3*v₁^2*u₂^3*v₂^3*u₃*v₃ +
        d^3*u₁^2*v₁^3*u₂^2*v₂^3*u₃*v₃^2*v₅ - a^2*d^2*u₁^2*v₁*u₂^3*v₂*u₃^2*v₃^2 -
        a^2*d^2*u₁^3*u₂^2*v₂^2*u₃^2*v₃^2 + a*d^2*u₁*v₁^2*u₂^2*v₂^2*u₃^2*v₃^2 +
        a*d^2*u₁^2*v₁*u₂*v₂^3*u₃^2*v₃^2 - a*d^2*u₁^2*v₁^3*u₂^2*v₂*u₃*v₅ -
        a*d^2*u₁^3*v₁^2*u₂*v₂^2*u₃*v₅ + a*d^2*u₁^3*v₁^2*u₂^2*v₂*v₃*v₅ -
        a*d^2*u₁*v₁^2*u₂^2*v₂*u₃^2*v₃*v₅ - a*d^2*u₁^2*v₁*u₂*v₂^2*u₃^2*v₃*v₅ -
        a*d^2*u₁^2*v₁*u₂^2*v₂*u₃*v₃^2*v₅ - a*d^2*u₁^3*v₁^2*u₂^2*v₂^2 -
        d^2*u₁^2*v₁^3*u₂*v₂^2*v₃*v₅ + d^2*u₁*v₁^2*u₂*v₂^2*u₃*v₃^2*v₅ + a^2*d*u₁^2*v₁*u₂^2*u₃*v₃
        + a^2*d*u₁^3*u₂*v₂*u₃*v₃ - a*d*u₁*v₁^2*u₂*v₂*u₃*v₃ - a*d*u₁^2*v₁*v₂^2*u₃*v₃ +
        a*d*u₁*v₁^2*u₂*u₃*v₅ + a*d*u₁^2*v₁*v₂*u₃*v₅ + a*d*u₁^2*v₁*u₂*v₃*v₅ - a*d*u₁*u₂*v₂*u₃*v₃
        - d*u₁*v₁^2*v₂*v₃*v₅ + a*u₁) * e₅u
      + (d^3*u₁^2*v₁^3*u₂^3*v₂^3*u₃*v₃ - a*d^2*u₁^2*v₁^3*u₂^2*v₂^2*u₃^2 -
        a*d^2*u₁^3*v₁^2*u₂*v₂^3*u₃^2 - a*d^2*u₁^2*v₁^3*u₂^3*v₂*u₃*v₃ +
        a*d^2*u₁^3*v₁^2*u₂^3*v₂*v₃^2 - a*d^2*u₁*v₁^2*u₂^3*v₂*u₃^2*v₃^2 -
        a*d^2*u₁^2*v₁*u₂^2*v₂^2*u₃^2*v₃^2 - d^2*u₁^2*v₁^3*u₂*v₂^3*u₃*v₃ -
        d^2*u₁^2*v₁^3*u₂^2*v₂^2*v₃^2 + d^2*v₁^3*u₂^2*v₂^2*u₃^2*v₃^2 +
        d^2*u₁*v₁^2*u₂*v₂^3*u₃^2*v₃^2 + d^2*u₁^2*v₁^3*u₂^2*v₂^2 + a*d*u₁*v₁^2*u₂*v₂*u₃^2 +
        a*d*u₁^2*v₁*v₂^2*u₃^2 + a*d*u₁^2*v₁*u₂*v₂*u₃*v₃ + a*d*u₁^2*v₁*u₂^2*v₃^2 +
        d*v₁^3*u₂*v₂*u₃*v₃ - d*u₁*v₁^2*u₂*v₂*v₃^2 - d*v₁*u₂*v₂*u₃*v₃ - v₁) * e₅v

end CompElliptic.CurveForms.CtEdwards
