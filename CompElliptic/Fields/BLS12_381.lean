import CompPoly.Fields.PrattCertificate
import CompElliptic.Fields.Sqrt
import Mathlib.NumberTheory.LegendreSymbol.Basic

/-!
# The BLS12-381 scalar prime field

`BLS12_381_SCALAR_CARD` is `r_𝕊`, the order of the scalar field of BLS12-381 and the base field
of the Jubjub curve (Zcash Protocol Specification
[§5.4.9.2 "BLS12-381 pairing"](https://zips.z.cash/protocol/protocol.pdf#blspairing)). We give
`r_𝕊` a Lucas/Pratt primality certificate, following the pattern of `CompElliptic.Fields.Pasta`;
the certificate was generated by `scripts/gen_bls12_381.py` from the factorization of `r_𝕊 - 1`
(PARI/GP). The BLS12-381 base field, curve, and pairing are not defined here.

The Tonelli–Shanks instance `bls12_381Scalar` has root of unity `7ᵀ`. Its order is checked by the
kernel rather than by `native_decide`, from Euler's criterion (`7` is a non-residue,
`seven_not_isSquare`) and Fermat's little theorem.
-/

namespace CompElliptic.Fields.BLS12_381

/-- The order `r_𝕊` of the BLS12-381 scalar field. -/
@[reducible] def BLS12_381_SCALAR_CARD : Nat := 0x73eda753299d7d483339d80809a1d80553bda402fffe5bfeffffffff00000001

/-- The BLS12-381 scalar field `𝔽_{r_𝕊}`, the base field of the Jubjub curve. -/
abbrev BLS12381ScalarField := ZMod BLS12_381_SCALAR_CARD

/-- `r_𝕊` is prime, by a Pratt certificate. -/
theorem BLS12_381_SCALAR_is_prime : Nat.Prime BLS12_381_SCALAR_CARD := by
  unfold BLS12_381_SCALAR_CARD
  refine PrattCertificate'.out (p := 52435875175126190479447740508185965837690552500527637822603658699938581184513) ⟨7, (by reduce_mod_char), ?_⟩
  refine .split [2 ^ 32, 3, 11, 19, 10177, 125527, 859267, 906349 ^ 2, 2508409, 2529403, 52437899, 254760293 ^ 2] (fun r hr => ?_) (by norm_num)
  simp at hr
  rcases hr with hr | hr | hr | hr | hr | hr | hr | hr | hr | hr | hr | hr
  all_goals rw [hr]
  · exact .prime 2 32 _ (by pratt) (by reduce_mod_char; decide) (by norm_num)
  · exact .prime 3 1 _ (by pratt) (by reduce_mod_char; decide) (by norm_num)
  · exact .prime 11 1 _ (by pratt) (by reduce_mod_char; decide) (by norm_num)
  · exact .prime 19 1 _ (by pratt) (by reduce_mod_char; decide) (by norm_num)
  · exact .prime 10177 1 _ (by pratt) (by reduce_mod_char; decide) (by norm_num)
  · exact .prime 125527 1 _ (by pratt) (by reduce_mod_char; decide) (by norm_num)
  · exact .prime 859267 1 _ (by pratt) (by reduce_mod_char; decide) (by norm_num)
  · exact .prime 906349 2 _ (by pratt) (by reduce_mod_char; decide) (by norm_num)
  · exact .prime 2508409 1 _ (by pratt) (by reduce_mod_char; decide) (by norm_num)
  · exact .prime 2529403 1 _ (by pratt) (by reduce_mod_char; decide) (by norm_num)
  · exact .prime 52437899 1 _ (by pratt) (by reduce_mod_char; decide) (by norm_num)
  · exact .prime 254760293 2 _ (by pratt) (by reduce_mod_char; decide) (by norm_num)

instance : Fact (Nat.Prime BLS12_381_SCALAR_CARD) := ⟨BLS12_381_SCALAR_is_prime⟩
instance : Field BLS12381ScalarField := ZMod.instField BLS12_381_SCALAR_CARD

/-- `7` is nonzero in the BLS12-381 scalar field. -/
theorem seven_ne_zero : (7 : BLS12381ScalarField) ≠ 0 := by decide

/-- `7` is a non-residue in the BLS12-381 scalar field, by Euler's criterion. -/
theorem seven_not_isSquare : ¬ IsSquare (7 : BLS12381ScalarField) := by
  rw [ZMod.euler_criterion BLS12_381_SCALAR_CARD seven_ne_zero]
  reduce_mod_char
  decide

/-- `7ᵀ = 0x16a2a19edfe81f20d09b681922c813b4b63683508c2280b93829971f439f0d2b`,
where `T = (r_𝕊 - 1)/2^32`. Stated over `ZMod`, because `reduce_mod_char` keys on the `ZMod`
spelling of the type, which the `BLS12381ScalarField` abbrev hides. -/
theorem seven_pow_oddPart :
    (7 : ZMod BLS12_381_SCALAR_CARD) ^ ((BLS12_381_SCALAR_CARD - 1) / 2 ^ 32) =
      0x16a2a19edfe81f20d09b681922c813b4b63683508c2280b93829971f439f0d2b := by
  reduce_mod_char

/-- Tonelli–Shanks data for the BLS12-381 scalar field `𝔽_{r_𝕊}`: `r_𝕊 - 1 = 2^32 · T`, with
`rootOfUnity = 7ᵀ` (`seven_pow_oddPart`). -/
def bls12_381Scalar : TonelliShanks BLS12381ScalarField where
  twoAdicity := 32
  oddPart := 0x73eda753299d7d483339d80809a1d80553bda402fffe5bfeffffffff
  rootOfUnity := 0x16a2a19edfe81f20d09b681922c813b4b63683508c2280b93829971f439f0d2b
  valid := {
    rootOfUnity_order := by
      haveI : Fact (Nat.Prime 2) := ⟨Nat.prime_two⟩
      rw [← seven_pow_oddPart]
      refine orderOf_eq_prime_pow (p := 2) ?_ ?_
      · rw [← pow_mul, show (BLS12_381_SCALAR_CARD - 1) / 2 ^ 32 * 2 ^ 31 =
          BLS12_381_SCALAR_CARD / 2 by decide]
        exact fun h => seven_not_isSquare ((ZMod.euler_criterion _ seven_ne_zero).mpr h)
      · rw [← pow_mul, show (BLS12_381_SCALAR_CARD - 1) / 2 ^ 32 * 2 ^ (31 + 1) =
          BLS12_381_SCALAR_CARD - 1 by decide]
        exact ZMod.pow_card_sub_one_eq_one seven_ne_zero }

-- `√4` squares back to `4`; `√7 = none` (7 is a non-residue, cf. `seven_not_isSquare`).
example : (bls12_381Scalar.sqrt? 4).map (· ^ 2) = some 4 := by native_decide
example : bls12_381Scalar.sqrt? 7 = none := by native_decide

end CompElliptic.Fields.BLS12_381
